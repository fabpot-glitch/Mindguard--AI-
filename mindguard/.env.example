# MindGuard AI - Example Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# API Configuration
# ============================================
# Host to bind the API server to
API_HOST=0.0.0.0
# Port to run the API server on
API_PORT=8000
# Number of worker processes
API_WORKERS=4
# Enable auto-reload (development only)
API_RELOAD=false
# Enable debug mode
API_DEBUG=false
# Secret key for JWT tokens (change in production!)
API_SECRET_KEY=your-super-secret-key-change-in-production
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================
# Model Configuration
# ============================================
# Path to PyTorch model weights
MODEL_PATH=models/weights/mindguard_best.pt
# Path to ONNX model (optional)
MODEL_ONNX_PATH=models/weights/mindguard.onnx
# Device to run inference on (cpu/cuda)
MODEL_DEVICE=cpu
# Minimum confidence threshold for predictions
MODEL_CONFIDENCE_THRESHOLD=0.7
# Inference frequency in Hz
MODEL_INFERENCE_FREQUENCY=5
# Batch size for inference
MODEL_BATCH_SIZE=32

# ============================================
# Data Collection
# ============================================
# Camera device ID
CAMERA_ID=0
# Camera capture FPS
CAMERA_FPS=30
# Audio sample rate in Hz
AUDIO_SAMPLE_RATE=16000
# Audio channels (1=mono, 2=stereo)
AUDIO_CHANNELS=1
# Keyboard sampling rate in Hz
KEYBOARD_SAMPLING_RATE=100
# Screen capture FPS
SCREEN_CAPTURE_FPS=5

# ============================================
# Alert Thresholds
# ============================================
# Fatigue thresholds (0-1)
FATIGUE_HIGH_THRESHOLD=0.8
FATIGUE_CRITICAL_THRESHOLD=0.9
# Stress threshold
STRESS_HIGH_THRESHOLD=0.75
# Attention threshold
ATTENTION_LOW_THRESHOLD=0.3
# Cognitive load threshold
COGNITIVE_LOAD_HIGH_THRESHOLD=0.85
# Seconds between interventions
INTERVENTION_COOLDOWN=120
# Maximum interventions per hour
MAX_INTERVENTIONS_PER_HOUR=5

# ============================================
# Logging
# ============================================
# Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# Log format (json/text)
LOG_FORMAT=json
# Log file path
LOG_FILE=logs/app.log

# ============================================
# Database
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://mindguard:mindguard@localhost:5432/mindguard
# Redis connection string
REDIS_URL=redis://localhost:6379

# ============================================
# Feature Flags
# ============================================
# Enable voice analysis
ENABLE_VOICE_ANALYSIS=true
# Enable screen monitoring
ENABLE_SCREEN_MONITORING=true
# Enable federated learning
ENABLE_FEDERATED_LEARNING=false
# Enable privacy mode (on-device processing)
PRIVACY_MODE=true

# ============================================
# Monitoring
# ============================================
# Enable Prometheus metrics
ENABLE_METRICS=true
# Prometheus metrics port
PROMETHEUS_PORT=9090
# Grafana dashboard port
GRAFANA_PORT=3000

# ============================================
# Email Alerts
# ============================================
# SMTP server for email alerts
SMTP_HOST=smtp.gmail.com
# SMTP port
SMTP_PORT=587
# SMTP username
SMTP_USER=alerts@mindguard.ai
# SMTP password
SMTP_PASSWORD=your-smtp-password
# Alert recipient email
ALERT_EMAIL=admin@mindguard.ai

# ============================================
# Federated Learning
# ============================================
# Federated learning server URL
FL_SERVER_URL=http://localhost:8080
# Minimum clients for training round
FL_MIN_CLIENTS=5
# Number of training rounds
FL_ROUNDS=10

# ============================================
# Data Storage
# ============================================
# Number of days to retain data
DATA_RETENTION_DAYS=30
# Enable automated backups
BACKUP_ENABLED=true
# Backup interval in hours
BACKUP_INTERVAL_HOURS=24
# Backup storage path
BACKUP_PATH=./backups

# ============================================
# Security
# ============================================
# JWT algorithm
JWT_ALGORITHM=HS256
# JWT expiration in hours
JWT_EXPIRATION_HOURS=24
# Bcrypt rounds for password hashing
BCRYPT_ROUNDS=12

# ============================================
# Rate Limiting
# ============================================
# Enable rate limiting
RATE_LIMIT_ENABLED=true
# Maximum requests per period
RATE_LIMIT_REQUESTS=100
# Rate limit period in seconds
RATE_LIMIT_PERIOD=60